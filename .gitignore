# La infraestructura Docker forma parte de este proyecto independiente.

# Agentes e infraestructura interna exclusivamente local
AGENTS.md
.agents/
.codex/
config/agent-loop/

# Carpetas de trabajo y soporte exclusivamente locales
analisis/
.tmp/
output/
outputs/
database/
!database/
!database/migrations/
!database/migrations/20260831_evaluation_attempt_presence.sql
!database/migrations/20260831_link_global_support_evaluation_results.sql
!database/migrations/20260831_link_people_management_evaluation_results.sql
docs/
scripts/

# Credenciales y claves locales
config/database.php
config/integrations.php
config/master.key
config/*.secure

# Dependencias instaladas; se reconstruyen con Composer
vendor/
sistema/vendor/
database/sistema/vendor/

# Dependencias frontend públicas requeridas por el runtime
!public/assets/vendor/
!public/assets/vendor/**
!public/assets/js/vendor/
!public/assets/js/vendor/**

# Datos generados localmente, respaldos y temporales
backups/
tmp/*
!tmp/.gitkeep
storage/*
!storage/.gitkeep
storage/agent-loop/runs/

# Analisis y artefactos locales no necesarios para ejecutar la plataforma
analisis/*.xlsx
public/error_log
public/tmp/*
!public/tmp/.gitkeep
public/uploads/
database/public/tmp/*
!database/public/tmp/.gitkeep
database/tmp/*
!database/tmp/.gitkeep
config/ambientes.local.env
deployment-*.txt
reports/db-structure/

# Cargas de usuarios; se conservan solo los assets de branding del proyecto
public/uploads/*
!public/uploads/.gitkeep
!public/uploads/branding/
!public/uploads/branding/**
